{
  "name": "pi-ui",
  "version": "0.0.0",
  "description": "UI upgrades for Pi coding agent, inspired by oh-my-pi and Claude Code",
  "type": "module",
  "license": "MIT",
  "keywords": ["pi-package", "pi-extension", "pi-coding-agent", "tui"],
  "files": ["src", "README.md"],
  "pi": {
    "extensions": ["./src/index.ts"]
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "preview:tool-call": "node --experimental-strip-types scripts/preview-tool-call.ts"
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*",
    "typebox": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-ai": "^0.86.0",
    "@earendil-works/pi-coding-agent": "^0.86.0",
    "@earendil-works/pi-tui": "^0.86.0",
    "@types/node": "^24.5.2",
    "typebox": "^1.3.27",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": ">=22"
  }
}
